{
  "version": 1,
  "notes": "Patterns are Python/GDScript-compatible regexes applied left to right on the whole word. V = vowel class. Order in this file is the canonical (correct) order. Verbs (-eti) are intentionally untouched by all rules: the deed stays readable, the doer is lost. Era-3 Institute anomaly: one word keeps 'kw' (see narrative doc).",
  "classes": {
    "V": "[aeiouāēīōū]",
    "FRONT": "[eiēī]"
  },
  "rules": [
    {
      "id": "R1",
      "era": 1,
      "kind": "consonant",
      "name_tr": "Sert ünsüzler",
      "note_tr": "bh → ph, dh → th, gh → kh",
      "subs": [
        [
          "bh",
          "ph"
        ],
        [
          "dh",
          "th"
        ],
        [
          "gh",
          "kh"
        ]
      ],
      "name_en": "Hard consonants",
      "note_en": "bh → ph, dh → th, gh → kh"
    },
    {
      "id": "R2",
      "era": 1,
      "kind": "vowel",
      "name_tr": "Çift ünlüler tekleşir",
      "note_tr": "ei → ī, eu → ū",
      "subs": [
        [
          "ei",
          "ī"
        ],
        [
          "eu",
          "ū"
        ]
      ],
      "name_en": "Double vowels merge",
      "note_en": "ei → ī, eu → ū"
    },
    {
      "id": "R3",
      "era": 2,
      "kind": "vowel",
      "name_tr": "Uzun ē yükselir",
      "note_tr": "ē → ī",
      "subs": [
        [
          "ē",
          "ī"
        ]
      ],
      "name_en": "Long ē rises",
      "note_en": "ē → ī"
    },
    {
      "id": "R4",
      "era": 2,
      "kind": "vowel",
      "name_tr": "Uzun ā öne kayar",
      "note_tr": "ā → ē",
      "subs": [
        [
          "ā",
          "ē"
        ]
      ],
      "name_en": "Long ā moves forward",
      "note_en": "ā → ē"
    },
    {
      "id": "R5",
      "era": 3,
      "kind": "consonant",
      "name_tr": "Sondaki s ve m düşer",
      "note_tr": "-s → ∅, -m → ∅ (kelime sonunda)",
      "subs": [
        [
          "s$",
          ""
        ],
        [
          "m$",
          ""
        ]
      ],
      "name_en": "Final s and m fall",
      "note_en": "-s → ∅, -m → ∅ (word-final)"
    },
    {
      "id": "R6",
      "era": 3,
      "kind": "consonant",
      "name_tr": "Damaklaşma",
      "note_tr": "kh → ş, k → ç, g → c (e, i önünde)",
      "subs": [
        [
          "kh(?={FRONT})",
          "ş"
        ],
        [
          "k(?={FRONT})",
          "ç"
        ],
        [
          "g(?={FRONT})",
          "c"
        ]
      ],
      "name_en": "Palatalisation",
      "note_en": "kh → ş, k → ç, g → c (before e, i)"
    },
    {
      "id": "R7",
      "era": 4,
      "kind": "consonant",
      "name_tr": "Sürtünmeliler",
      "note_tr": "ph → f, th → t, kw → p",
      "subs": [
        [
          "ph",
          "f"
        ],
        [
          "th",
          "t"
        ],
        [
          "kw",
          "p"
        ]
      ],
      "name_en": "Fricatives",
      "note_en": "ph → f, th → t, kw → p"
    },
    {
      "id": "R8",
      "era": 4,
      "kind": "vowel",
      "name_tr": "Son ünlü düşer",
      "note_tr": "-o, -e → ∅ (tek ünsüzden sonra, kelime sonunda)",
      "subs": [
        [
          "(?<={V}[^aeiouāēīōū])[oe]$",
          ""
        ]
      ],
      "name_en": "Final vowel falls",
      "note_en": "-o, -e → ∅ (after one consonant, word-final)"
    }
  ]
}
